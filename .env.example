# Copy this file to .env and fill in the values.  (cp .env.example .env)

# Your public website address, without a trailing slash. Used for Google (sitemap, links, certificates).
SITE_URL=https://jumis.uz

# Port the server listens on (most hosts set this for you)
PORT=3000

# Claude AI — powers Ziyrek AI, test analysis, assignment feedback, question generation.
# Get a key at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=
# Optional: which Claude model to use
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email (enrollment codes, password reset, vacancy notices) via https://resend.com
# Leave empty to skip email: enrollment is then confirmed without a code, and emails are printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=Jumis AI <noreply@jumis.uz>

# Google Search Console "HTML tag" verification code (only the content="..." value)
GOOGLE_SITE_VERIFICATION=

# Where the database and uploaded files are stored. Must be on a persistent disk/volume in production.
DATA_DIR=./data

# Default site language: kaa (Karakalpak), uz, ru or en
DEFAULT_LANG=kaa

# Max upload size in MB (videos, CVs)
MAX_UPLOAD_MB=100

# Timezone used for schedules and dates
TZ=Asia/Tashkent

# Set to 1 to try every AI feature with sample answers and no API key (for testing only)
AI_MOCK=
